PORT=4000
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/localstride?sslmode=require
CORS_ORIGINS=http://localhost:3000,https://localstride.kr

# 공공데이터포털 Decoding 키. 공모전 심사·운영 환경에서는 TOURAPI_KEY가 필수입니다.
TOURAPI_KEY=
KMA_KEY=
AIRKOREA_KEY=

# 선택 기능
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
ALLOW_PROGRAM_REGISTRATION=false
ALLOW_DEMO_RUNS=false

# 관리자: 이메일은 쉼표로 구분합니다. 최초 가입 코드는 서버에만 보관하세요.
ADMIN_EMAILS=admin@example.com
ADMIN_SETUP_CODE=replace-with-a-long-random-one-time-code

# EC2의 영구 보관 디렉터리를 지정하는 것을 권장합니다.
UPLOAD_DIR=/home/ubuntu/localstride-uploads
