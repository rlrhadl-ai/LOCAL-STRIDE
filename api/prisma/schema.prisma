// LOCAL STRIDE 데이터 모델
// 좌표는 lat/lng Float로 저장하고 반경 검색은 bbox + haversine으로 처리한다.
// (PostGIS는 트래픽이 커지면 마이그레이션 한 번으로 전환 — docs/data-model.md 참고)

generator client {
  provider   = "prisma-client-js"
  engineType = "client" // Rust 엔진 없이 TS 쿼리 컴파일러 + pg 드라이버 어댑터 사용
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CourseSource {
  OFFICIAL
  USER
}

enum RunMode {
  DEMO
  LIVE
}

enum RunStatus {
  ACTIVE
  FINISHED
  ABANDONED
}

enum PoiSource {
  TOURAPI
  SEED
}

enum MissionType {
  CHECKIN          // 코스 체크포인트 전부 체크인
  PERIOD_DISTANCE  // 기간 내 누적 거리
  MIRACLE_RUN      // 아침 시간대 출발 러닝
  LOCAL_FOOD       // 로컬 맛집 인증(사진+위치)
  WORKOUT          // 운동법 콘텐츠 수행
}

enum MatePostType {
  PACEMAKER
  MATE
}

enum MateStatus {
  OPEN
  CLOSED
}

enum ApplyStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EventStatus {
  DRAFT
  OPEN
  CLOSED
  FINISHED
  CANCELED
}

enum EventKind {
  RACE
  MORNING
  AFTER_WORK
  INDEPENDENT
  THEME
  POPUP
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum CrewRole {
  OWNER
  MEMBER
}

enum UserRole {
  USER
  ADMIN
}

enum PartnerStatus {
  COMING_SOON
  ACTIVE
  DEMO
  HIDDEN
}

// ---------- 사용자 (익명제: 공개는 닉네임, 뒤에서 신원 확인) ----------
model User {
  id                 String              @id @default(cuid())
  deviceId           String?             @unique
  kakaoId            String?             @unique
  email              String?             @unique
  passwordHash       String?
  role               UserRole            @default(USER)
  isActive           Boolean             @default(true)
  phoneVerified      Boolean             @default(false)
  nickname           String
  avatarColor        String              @default("#1B5BDF")
  avatarUrl          String?
  bio                String?
  homeArea           String              @default("대구 수성구")
  weeklyGoalKm       Int                 @default(20)
  preferredPaceSec   Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  runs               Run[]
  medals             UserMedal[]
  coupons            UserCoupon[]
  challenges         UserChallenge[]
  missions           MissionProgress[]
  crewMemberships    CrewMember[]
  ownedCrews         Crew[]
  matePosts          MatePost[]
  mateApplications   MateApplication[]
  eventRegistrations EventRegistration[]
  eventResults       EventResult[]
  hostedEvents       Event[]             @relation("HostedEvents")
  courses            Course[]
  adminSessions      AdminSession[]
}

model AdminSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------- 코스 ----------
model Course {
  id             String       @id @default(cuid())
  slug           String       @unique
  name           String
  description    String
  thumbnailUrl   String?
  distanceM      Int
  difficulty     String // 초급 / 초중급 / 중급 / 상급
  themes         String[] // 수변 / 야경 / 미식 / 역사 / 자연 / 골목
  areaName       String       @default("대구 수성구")
  startLat       Float
  startLng       Float
  polyline       Json // [[lat, lng], ...]
  elevationGainM Int          @default(0)
  estMinutes     Int
  isPublic       Boolean      @default(true)
  source         CourseSource @default(OFFICIAL)
  creatorId      String?
  creator        User?        @relation(fields: [creatorId], references: [id])
  createdAt      DateTime     @default(now())
  checkpoints    Checkpoint[]
  pois           CoursePoi[]
  runs           Run[]
  events         Event[]
  crewRuns       CrewRun[]
}

// ---------- 홈 운영 콘텐츠 ----------
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model Partner {
  id          String        @id @default(cuid())
  name        String
  category    String
  addr        String?
  offerTitle  String
  discountKrw Int?
  validUntil  DateTime?
  status      PartnerStatus @default(COMING_SOON)
  imageUrl    String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Checkpoint {
  id         String    @id @default(cuid())
  courseId   String
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order      Int
  name       String
  kind       String
  distM      Int
  lat        Float
  lng        Float
  radiusM    Int       @default(120)
  reward     Boolean   @default(false)
  dataSource String?
  checkins   Checkin[]

  @@unique([courseId, order])
}

// TourAPI locationBasedList2 응답을 캐시하는 테이블 (contentId 기준)
model Poi {
  id            String      @id @default(cuid())
  contentId     String?     @unique
  contentTypeId Int
  title         String
  addr1         String?
  lat           Float
  lng           Float
  firstImage    String?
  tel           String?
  overview      String?
  source        PoiSource
  fetchedAt     DateTime    @default(now())
  raw           Json?
  courses       CoursePoi[]

  @@index([lat, lng])
}

model CoursePoi {
  courseId       String
  poiId          String
  distFromStartM Int
  triggerRadiusM Int     @default(130)
  voice          String?
  course         Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  poi            Poi     @relation(fields: [poiId], references: [id], onDelete: Cascade)

  @@id([courseId, poiId])
}

// ---------- 러닝 ----------
model Run {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  courseId      String
  course        Course       @relation(fields: [courseId], references: [id])
  mode          RunMode
  status        RunStatus    @default(ACTIVE)
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  distanceM     Int          @default(0)
  durationSec   Int          @default(0)
  avgPaceSec    Int?
  track         Json? // [{lat, lng, t}]
  valid         Boolean      @default(true)
  invalidReason String?
  checkins      Checkin[]
  medals        UserMedal[]
  coupons       UserCoupon[]

  @@index([userId, finishedAt])
  @@index([courseId, durationSec])
}

model Checkin {
  id           String     @id @default(cuid())
  runId        String
  run          Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id])
  at           DateTime   @default(now())
  lat          Float?
  lng          Float?
  method       String     @default("GPS") // GPS / QR / DEMO

  @@unique([runId, checkpointId])
}

// ---------- 보상 ----------
model Medal {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String
  courseSlug  String?
  seasonCode  String?
  users       UserMedal[]
}

model UserMedal {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  medalId  String
  medal    Medal    @relation(fields: [medalId], references: [id])
  runId    String?
  run      Run?     @relation(fields: [runId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, medalId])
}

model Merchant {
  id        String   @id @default(cuid())
  name      String
  category  String
  lat       Float
  lng       Float
  addr      String?
  certified Boolean  @default(false) // 한국관광 품질인증 여부
  coupons   Coupon[]
}

model Coupon {
  id          String       @id @default(cuid())
  merchantId  String
  merchant    Merchant     @relation(fields: [merchantId], references: [id])
  title       String
  discountKrw Int
  courseSlug  String?
  validUntil  DateTime
  users       UserCoupon[]
}

model UserCoupon {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  couponId String
  coupon   Coupon    @relation(fields: [couponId], references: [id])
  runId    String?
  run      Run?      @relation(fields: [runId], references: [id])
  code     String    @unique
  issuedAt DateTime  @default(now())
  usedAt   DateTime?
}

model Challenge {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String
  targetCount Int
  courseSlugs String[]
  users       UserChallenge[]
}

model UserChallenge {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  challengeId    String
  challenge      Challenge @relation(fields: [challengeId], references: [id])
  completedSlugs String[]
  updatedAt      DateTime  @updatedAt

  @@unique([userId, challengeId])
}

// ---------- 미션 (기간별 / 미라클 런 / 로컬 맛집 인증 / 운동법) ----------
model Mission {
  id          String            @id @default(cuid())
  code        String            @unique
  type        MissionType
  title       String
  description String
  periodStart DateTime
  periodEnd   DateTime
  rule        Json // 예: {targetM: 10000} / {startHourFrom: 5, startHourTo: 8, count: 3}
  rewardText  String?
  progress    MissionProgress[]
}

model MissionProgress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id])
  value     Float    @default(0)
  done      Boolean  @default(false)
  proofUrl  String?
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId])
}

// ---------- 크루(모임) ----------
model Crew {
  id          String       @id @default(cuid())
  name        String
  description String
  lifestyle   String[] // 아침 / 저녁 / 주말 / 직장인 / 초보환영
  paceMinSec  Int // 초/km
  paceMaxSec  Int
  area        String
  openChatUrl String?
  ownerId     String
  owner       User         @relation(fields: [ownerId], references: [id])
  members     CrewMember[]
  runs        CrewRun[]
  createdAt   DateTime     @default(now())
}

model CrewMember {
  id       String   @id @default(cuid())
  crewId   String
  crew     Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  role     CrewRole @default(MEMBER)
  joinedAt DateTime @default(now())

  @@unique([crewId, userId])
}

model CrewRun {
  id       String   @id @default(cuid())
  crewId   String
  crew     Crew     @relation(fields: [crewId], references: [id], onDelete: Cascade)
  courseId String?
  course   Course?  @relation(fields: [courseId], references: [id])
  startsAt DateTime
  note     String?
}

// ---------- 대회 ----------
model Event {
  id            String              @id @default(cuid())
  slug          String              @unique
  title         String
  description   String
  kind          EventKind           @default(RACE)
  place         String?
  paceSec       Int?
  imageUrl      String?
  hostId        String?
  host          User?               @relation("HostedEvents", fields: [hostId], references: [id])
  courseId      String?
  course        Course?             @relation(fields: [courseId], references: [id])
  startsAt      DateTime
  capacity      Int
  feeKrw        Int                 @default(0)
  tshirt        Boolean             @default(false)
  status        EventStatus         @default(OPEN)
  registrations EventRegistration[]
  results       EventResult[]

  @@index([kind, status, startsAt])
  @@index([hostId])
}

model EventRegistration {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  bib        Int?
  tshirtSize String?
  paid       Boolean  @default(false)
  paymentRef String?
  status     RegistrationStatus @default(REGISTERED)
  checkedInAt DateTime?
  createdAt  DateTime @default(now())

  @@unique([eventId, userId])
}

model EventResult {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  timeSec   Int
  distanceM Int
  rank      Int?
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
}

// ---------- 러닝 메이트 ----------
model MatePost {
  id           String            @id @default(cuid())
  authorId     String
  author       User              @relation(fields: [authorId], references: [id])
  type         MatePostType
  paceSec      Int
  meetAt       DateTime
  place        String
  slots        Int
  body         String
  status       MateStatus        @default(OPEN)
  applications MateApplication[]
  createdAt    DateTime          @default(now())
}

model MateApplication {
  id        String      @id @default(cuid())
  postId    String
  post      MatePost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  status    ApplyStatus @default(PENDING)
  createdAt DateTime    @default(now())

  @@unique([postId, userId])
}
