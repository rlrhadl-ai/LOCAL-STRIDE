NEXT_PUBLIC_API_URL=http://localhost:4000

# Vercel rewrite를 사용할 때는 NEXT_PUBLIC_API_URL=/ 로 두고
# 서버 전용 API_ORIGIN에 실제 API 주소를 설정합니다.
API_ORIGIN=

# AI mate: deployed Vercel functions use project OIDC automatically.
# Enable only after AI Gateway usage has been activated and verified.
AI_MATE_ENABLED=false
# Local development only: set a gateway key in the uncommitted .env.local.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=anthropic/claude-haiku-5.5
